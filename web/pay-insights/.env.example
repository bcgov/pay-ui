# Web Urls
NUXT_PUBLIC_BASE_URL="http://localhost:3002/"
NUXT_PUBLIC_REGISTRY_HOME_URL="https://dev.bcregistry.gov.bc.ca/"

# Status API (system banner in the header)
NUXT_PUBLIC_STATUS_API_URL="https://status-api-dev.apps.gold.devops.gov.bc.ca"
NUXT_PUBLIC_STATUS_API_VERSION="/api/v1"

# LaunchDarkly
NUXT_PUBLIC_LD_CLIENT_ID=""

# Identity Provider
NUXT_PUBLIC_IDP_URL="https://dev.loginproxy.gov.bc.ca/auth"
NUXT_PUBLIC_IDP_REALM="bcregistry"
NUXT_PUBLIC_SITEMINDER_LOGOUT_URL="https://logontest7.gov.bc.ca/clp-cgi/logoff.cgi"

# Server-side login — Keycloak public client (PKCE). Server only, not NUXT_PUBLIC_
NUXT_IDP_CLIENTID=""

# Session cookie encryption — at least 32 random characters (server only)
NUXT_SESSION_PASSWORD=""

# Data warehouse (server only)
# In GCP: set the instance connection name and IAM user (Cloud SQL connector, IAM auth)
NUXT_WAREHOUSE_INSTANCE_CONNECTION_NAME=""
NUXT_WAREHOUSE_IAM_USER=""
# Local development: connect through cloud-sql-proxy instead
NUXT_WAREHOUSE_HOST="127.0.0.1"
NUXT_WAREHOUSE_USER=""
NUXT_WAREHOUSE_PASSWORD=""
