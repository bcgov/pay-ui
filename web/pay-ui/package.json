{
  "name": "pay-ui",
  "version": "3.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build-check": "nuxt build",
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev-proxy": "nuxt dev --host 0.0.0.0",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint --fix .",
    "lint:check": "eslint .",
    "test": "vitest --dir tests/unit",
    "test:unit": "vitest --dir tests/unit",
    "test:unit:cov": "vitest --dir tests/unit --coverage",
    "build:test": "pnpm generate && npx serve .output/public"
  },
  "dependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@nuxt/test-utils": "^4.3.3",
    "@sbc-connect/nuxt-forms": "^0.9.0",
    "@sbc-connect/nuxt-pay": "^0.8.0",
    "@types/lodash": "^4.17.26",
    "es-toolkit": "^1.52.0",
    "lodash": "^4.18.1",
    "luxon": "^3.7.2",
    "nuxt": "4.6.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-sanitize-directive": "^0.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@nuxt/eslint-config": "1.17.0",
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "^1.64.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.5.1",
    "baseline-browser-mapping": "^2.11.29",
    "dotenv": "^18.0.8",
    "eslint": "10.12.0",
    "happy-dom": "^21.0.1",
    "sass": "^1.105.1",
    "sass-embedded": "^1.105.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.13"
  }
}
