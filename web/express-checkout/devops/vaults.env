# Web URLs
NUXT_PUBLIC_BASE_URL="op://web-url/$APP_ENV/express-checkout/EXPRESS_CHECKOUT_WEB_URL" # TODO: DevOps to create vault entry
NUXT_PUBLIC_AUTH_WEB_URL="op://web-url/$APP_ENV/auth-web/AUTH_WEB_URL"

# APIGEE key
NUXT_PUBLIC_X_API_KEY="op://API/$APP_ENV/business-api/BUSINESS_API_KEY" # TODO: confirm same key or dedicated express-checkout entry

# App name (header sent with every API call, distinguishes traffic in logs)
NUXT_PUBLIC_APP_NAME="express-checkout"

# Status API
NUXT_PUBLIC_STATUS_API_URL="op://API/$APP_ENV/status-api/STATUS_API_URL"
NUXT_PUBLIC_STATUS_API_VERSION="op://API/$APP_ENV/status-api/STATUS_API_VERSION"

# Auth API
NUXT_PUBLIC_AUTH_API_URL="op://API/$APP_ENV/auth-api/AUTH_API_URL"
NUXT_PUBLIC_AUTH_API_VERSION="op://API/$APP_ENV/auth-api/AUTH_API_VERSION"

# Pay API
NUXT_PUBLIC_PAY_API_URL="op://API/$APP_ENV/pay-api/PAY_API_URL"
NUXT_PUBLIC_PAY_API_VERSION="op://API/$APP_ENV/pay-api/PAY_API_VERSION"

# LaunchDarkly
NUXT_PUBLIC_LD_CLIENT_ID="op://launchdarkly/$APP_ENV/pay/PAY_LD_CLIENT_ID"

# Identity Provider (Keycloak) — express-checkout uses its own Keycloak client for the
# public payer landing; ask DevOps for the client id/name.
NUXT_PUBLIC_IDP_URL="op://keycloak/$APP_ENV/base/KEYCLOAK_AUTH_BASE_URL"
NUXT_PUBLIC_IDP_REALM="op://keycloak/$APP_ENV/base/KEYCLOAK_REALMNAME"
NUXT_PUBLIC_IDP_CLIENTID="op://keycloak/$APP_ENV/express-checkout/UI_KEYCLOAK_RESOURCE_NAME" # TODO: DevOps to provision Keycloak client
NUXT_PUBLIC_SITEMINDER_LOGOUT_URL="op://web-url/$APP_ENV/siteminder/SITEMINDER_LOGOUT_URL"
